# Copy to .env (git-ignored). `npm run dev` reads it; in production set these on the container instead.

# Where the app is reached from a browser, no trailing slash. Providers redirect back here.
PUBLIC_URL=http://localhost:5174

# Sign-in keys can also be entered by an admin under Settings > Sign-in; these win when set.
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
#   Authorised redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: discord.com/developers/applications > your app > OAuth2
#   Redirect: <PUBLIC_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Accounts that are admins, as provider:id, comma-separated. Your own id is shown under Settings > Account after you sign in.
ADMIN_IDS=
